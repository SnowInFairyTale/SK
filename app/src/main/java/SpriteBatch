        this.lockSubmit = lockSubmit;
    }

    public void dispose() {
        for(int i = 0; i < this.buffers.length; ++i) {
            this.buffers[i].dispose();
        }

        if (this.lineLazy != null) {
            this.lineLazy.clear();
        }

        if (whitePixel != null) {
            whitePixel.destroy();
        }

        if (this.batch != null) {
            this.batch.dispose();
        }

    }

